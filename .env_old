#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Leave empty to auto-detect. Set explicitly if running under a subfolder,
# e.g. app.baseURL = 'http://localhost/post_sql/public/'
# Using the literal 127.0.0.1 (not 'localhost') so PHP's built-in server
# binds unambiguously to IPv4 — 'localhost' resolves to both ::1 and
# 127.0.0.1 on this machine, and PHP was picking IPv6-only, which left
# http://127.0.0.1:8080/ (and sometimes http://localhost:8080/, depending
# on the browser's own IPv6/IPv4 preference) refusing to connect.
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (PostgreSQL)
#--------------------------------------------------------------------
# Requires PHP extensions: pgsql + pdo_pgsql (enable in php.ini) and a
# running PostgreSQL server. Create the database first:
#   CREATE DATABASE post_sql;
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = timetrack1
database.default.username = postgres
database.default.password = 3124
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 3307
database.default.schema = public
database.default.charset = utf8

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = hex2bin:5b3c1d9f8a7e6c4b2a0f1e3d5c7b9a8f6e4d2c1b0a9f8e7d6c5b4a3f2e1d0c9b

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# Use app/Config/Session.php: WRITEPATH . 'session' (portable across computers).
# Do not set this to null: it can create a literal public/null directory.

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

